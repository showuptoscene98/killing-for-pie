{
  "name": "zombie-game",
  "version": "0.1.0",
  "private": true,
  "description": "Killing for Pie! — zombie survival (GitHub Pages)",
  "author": "Killing for Pie",
  "main": "electron/main.js",
  "homepage": "https://showuptoscene98.github.io/killing-for-pie/",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.112.2",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.2"
  },
  "scripts": {
    "dev": "vite",
    "start": "node scripts/dev-with-coop.js",
    "start:web": "vite",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "build": "npm run typecheck && vite build",
    "electron:dev": "node scripts/electron-dev.js",
    "electron": "electron .",
    "electron:live": "cross-env ELECTRON_START_URL=https://showuptoscene98.github.io/killing-for-pie/ electron .",
    "electron:local": "node scripts/electron-dev.js",
    "coop-server": "node scripts/coop-server.js",
    "deploy:pages": "npm run build && npx --yes gh-pages -d build",
    "build:desktop": "npm --prefix electron run dist",
    "dist": "npm run build:desktop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
