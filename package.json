{
  "name": "zombie-game",
  "version": "0.1.0",
  "private": true,
  "description": "Killing for Pie! — zombie survival (GitHub Pages)",
  "author": "Killing for Pie",
  "main": "electron/main.js",
  "homepage": "https://showuptoscene98.github.io/killing-for-pie/",
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scripts": "5.0.1",
    "three": "^0.185.1",
    "web-vitals": "^2.1.4",
    "ws": "^8.21.2"
  },
  "scripts": {
    "start": "node scripts/dev-with-coop.js",
    "start:web": "cross-env HOST=0.0.0.0 react-scripts start",
    "electron:dev": "node scripts/electron-dev.js",
    "electron": "electron .",
    "electron:live": "cross-env ELECTRON_START_URL=https://showuptoscene98.github.io/killing-for-pie/ electron .",
    "deploy:pages": "npm run build && npx --yes gh-pages -d build",
    "electron:local": "node scripts/electron-dev.js",
    "coop-server": "node scripts/coop-server.js",
    "build": "react-scripts build",
    "build:desktop": "npm --prefix electron run dist",
    "dist": "npm run build:desktop",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
